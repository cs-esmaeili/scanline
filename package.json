{
  "name": "vs-search-overlay",
  "displayName": "Search Overlay",
  "description": "Search Everywhere: open VS Code search in a tab with scope and file-type filters. Native search under the hood.",
  "version": "0.7.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsSearch.search",
        "title": "Search Everywhere",
        "icon": {
          "light": "media/icon.svg",
          "dark": "media/icon.svg"
        }
      },
      {
        "command": "vsSearch.searchSelection",
        "title": "Search: Search with Selection"
      },
      {
        "command": "vsSearch.searchToSide",
        "title": "Search: Search in Files (Search Editor)"
      },
      {
        "command": "vsSearch.close",
        "title": "Search: Close Search Page"
      },
      {
        "command": "vsSearch.searchInFolder",
        "title": "Search in This Folder",
        "icon": "$(search)"
      }
    ],
    "keybindings": [
      {
        "command": "vsSearch.search",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f"
      },
      {
        "command": "vsSearch.searchSelection",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s"
      }
    ],
    "configuration": {
      "title": "Search Overlay",
      "properties": {
        "vsSearch.theme": {
          "type": "string",
          "enum": [
            "phpstorm",
            "vscode"
          ],
          "enumDescriptions": [
            "Fixed Darcula-like palette, closest to PhpStorm",
            "Follow the current VS Code theme colors"
          ],
          "default": "phpstorm",
          "description": "Color palette of the overlay."
        },
        "vsSearch.maxResults": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 200,
          "description": "Maximum number of results per provider (files, text, symbols, actions)."
        },
        "vsSearch.target": {
          "type": "string",
          "enum": [
            "searchEditor",
            "sidebarPanel"
          ],
          "enumDescriptions": [
            "Open VS Code's native Search Editor in the editor area",
            "Use the left sidebar search view"
          ],
          "default": "searchEditor",
          "description": "Where `Search: Open Search to the Side` and Alt+Enter send the query."
        },
        "vsSearch.reuseSearchEditor": {
          "type": "boolean",
          "default": true,
          "description": "Reuse an existing Search Editor tab instead of opening a new one."
        },
        "vsSearch.showIncludesExcludes": {
          "type": "boolean",
          "default": false,
          "description": "Show the 'files to include / exclude' inputs in the Search Editor."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "vsSearch.search",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "vsSearch.searchInFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies --allow-missing-repository --baseImagesUrl https://example.invalid/vs-search"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.32.0",
    "typescript": "^5.5.4"
  }
}
