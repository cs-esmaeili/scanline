{
  "name": "scanline",
  "displayName": "Scanline",
  "description": "Search files, text, symbols and commands in one tab, with folder scope and file-type filters.",
  "version": "0.7.2",
  "publisher": "JavadEsmaeili",
  "author": {
    "name": "Javad Esmaeili",
    "email": "cs.esmaeili@gmail.com"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "search",
    "find",
    "search everywhere",
    "search editor",
    "grep",
    "ripgrep",
    "fuzzy",
    "quick search",
    "workspace search"
  ],
  "galleryBanner": {
    "color": "#2b2b2b",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cs-esmaeili/scanline"
  },
  "bugs": {
    "url": "https://github.com/cs-esmaeili/scanline/issues"
  },
  "homepage": "https://github.com/cs-esmaeili/scanline#readme",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scanline.search",
        "title": "Scanline: Search Everywhere",
        "icon": {
          "light": "media/icon.svg",
          "dark": "media/icon.svg"
        }
      },
      {
        "command": "scanline.searchSelection",
        "title": "Scanline: Search with Selection"
      },
      {
        "command": "scanline.searchToSide",
        "title": "Scanline: Open in Search Editor"
      },
      {
        "command": "scanline.close",
        "title": "Scanline: Close Search Tab"
      },
      {
        "command": "scanline.searchInFolder",
        "title": "Scanline: Search in This Folder",
        "icon": "$(search)"
      }
    ],
    "keybindings": [
      {
        "command": "scanline.search",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+f"
      },
      {
        "command": "scanline.searchSelection",
        "key": "ctrl+alt+shift+s",
        "mac": "cmd+alt+shift+s"
      }
    ],
    "configuration": {
      "title": "Scanline",
      "properties": {
        "scanline.theme": {
          "type": "string",
          "enum": [
            "dark",
            "vscode"
          ],
          "enumDescriptions": [
            "Fixed dark, high-contrast palette",
            "Follow the current VS Code theme colors"
          ],
          "default": "dark",
          "description": "Color palette of the search tab."
        },
        "scanline.maxResults": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 200,
          "description": "Maximum number of results per provider (files, text, symbols, actions)."
        },
        "scanline.target": {
          "type": "string",
          "enum": [
            "searchEditor",
            "sidebarPanel"
          ],
          "enumDescriptions": [
            "Open VS Code's native Search Editor in the editor area",
            "Use the left sidebar search view"
          ],
          "default": "searchEditor",
          "description": "Where `Search: Open Search to the Side` and Alt+Enter send the query."
        },
        "scanline.reuseSearchEditor": {
          "type": "boolean",
          "default": true,
          "description": "Reuse an existing Search Editor tab instead of opening a new one."
        },
        "scanline.showIncludesExcludes": {
          "type": "boolean",
          "default": false,
          "description": "Show the 'files to include / exclude' inputs in the Search Editor."
        },
        "scanline.desktopSync": {
          "type": "boolean",
          "default": false,
          "description": "Write the current workspace folders to ~/.config/scanline/workspace.json so the separate desktop overlay app can read them. Off by default; nothing is written outside the workspace unless you turn this on."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "scanline.search",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "scanline.searchInFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run clean && npm run compile",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "typescript": "^5.5.4"
  }
}
